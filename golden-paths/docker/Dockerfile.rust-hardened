# ==============================================================================
# Hardened Multi-Stage Rust Build (Zero CVE, Alpine 3.21 / Musl Static)
# ==============================================================================

# --- Stage 1: Build dependencies with Cargo Chef ---
FROM rust:1.85-alpine3.21 AS chef
RUN apk update && apk upgrade && apk add --no-cache musl-dev pkgconfig openssl-dev openssl-libs-static
RUN cargo install cargo-chef --version ^0.1
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Build and cache dependencies layer
RUN cargo chef cook --release --target x86_64-unknown-linux-musl --recipe-path recipe.json
# Build application
COPY . .
RUN cargo build --release --target x86_64-unknown-linux-musl

# --- Stage 2: Hardened Scratch / Distroless Runner ---
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app
COPY --from=builder /app/target/x86_64-unknown-linux-musl/release/app /app/app

# Non-root execution
USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/app/app"]
